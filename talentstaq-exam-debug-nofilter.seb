<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ==================== DEBUG ONLY ==================== -->
  <!-- URL filter disabled to isolate whether it's the whitelist causing
       the blank screen. Do NOT send this to real candidates — it has no
       URL restrictions at all. Delete once the real cause is found. -->
  <key>startURL</key>
  <string>https://experiment.talentstaq.ai/test/login</string>

  <key>browserViewMode</key>
  <integer>1</integer>
  <key>allowBrowsingBackForward</key>
  <false/>
  <key>browserWindowAllowReload</key>
  <true/> <!-- allow reload here, purely for debugging -->
  <key>newBrowserWindowByLinkPolicy</key>
  <integer>2</integer> <!-- allow, in case the app opens something in a new tab/window -->
  <key>newBrowserWindowByScriptPolicy</key>
  <integer>2</integer>
  <key>enableBrowserWindowToolbar</key>
  <true/> <!-- show toolbar so you can see the actual URL/errors while debugging -->
  <key>hideBrowserWindowToolbar</key>
  <false/>
  <key>showMenuBar</key>
  <false/>
  <key>showTaskBar</key>
  <true/>
  <key>showTime</key>
  <true/>
  <key>allowedDisplaysMaxNumber</key>
  <integer>1</integer>

  <key>allowQuit</key>
  <true/>
  <key>quitURLConfirm</key>
  <false/>
  <key>hashedQuitPassword</key>
  <string></string>

  <!-- ==================== URL WHITELIST: DISABLED FOR THIS TEST ==================== -->
  <key>URLFilterEnable</key>
  <false/>
  <key>URLFilterEnableContentFilter</key>
  <false/>

  <key>allowAudioCapture</key>
  <true/>
  <key>allowVideoCapture</key>
  <true/>

  <key>allowVirtualMachine</key>
  <false/>
  <key>allowScreenSharing</key>
  <false/>
  <key>allowWLAN</key>
  <false/>

  <key>enableLogging</key>
  <true/>
  <key>sebConfigPurpose</key>
  <integer>0</integer>

  <key>hashedAdminPassword</key>
  <string></string>

  <key>originatorVersion</key>
  <string>SEB_Win_3.6.0</string>

</dict>
</plist>
