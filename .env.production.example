# Production env template for the DigitalOcean droplet (4 vCPU / 8GB).
# Copy to backend/.env on the droplet and fill in every REPLACE_ME value.
# This mirrors backend/.env's structure — see deploy/DEPLOYMENT.md for the
# full setup runbook.

# ==================== DATABASE (self-hosted Postgres via deploy/docker-compose.prod.yml) ====================
# user/password/db here must match deploy/.env's POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
DATABASE_URL="postgresql://talentq:REPLACE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/test_platform"

# ==================== AUTH SECRETS ====================
# Generate fresh values for production — do NOT reuse dev secrets.
# e.g. `openssl rand -hex 64`
JWT_SECRET="REPLACE_ME_GENERATE_NEW_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_ME_GENERATE_NEW_RANDOM_SECRET"
RECRUITER_JWT_SECRET="REPLACE_ME_IF_HRIA_INTEGRATION_IS_USED"
RECRUITER_JWT_ISSUER="https://recruit.hria.io"
RECRUITER_JWT_AUDIENCE="exam.talentstaq.ai"
INTEGRATION_PROVIDER="recruit_portal"
INTEGRATION_ACCESS_TOKEN_EXPIRY="15m"
INTEGRATION_REFRESH_TOKEN_EXPIRY_DAYS=30
INTERNAL_SECRET="REPLACE_ME_GENERATE_NEW_RANDOM_SECRET"
PROCTOR_ENGINE_API_KEY="REPLACE_ME_GENERATE_NEW_RANDOM_SECRET"

# ==================== SERVER ====================
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://REPLACE_ME_YOUR_DOMAIN.com"

# ==================== REDIS (self-hosted via deploy/docker-compose.prod.yml) ====================
# password here must match deploy/.env's REDIS_PASSWORD
REDIS_URL="redis://:REPLACE_ME_REDIS_PASSWORD@127.0.0.1:6379"

# ==================== CODE EXECUTION (Docker sandbox + BullMQ) ====================
CODE_EXEC_DOCKER_IMAGE=talentq/code-exec:prod
CODE_EXEC_SCRATCH_ROOT=/var/lib/talentq/code-exec-scratch
# 4 vCPU droplet: start conservative and raise only if /api/health/queues
# shows headroom under real load. concurrency x per-container CPU should not
# exceed the box's core count once Postgres/Redis/API/Python-CV are accounted for.
CODE_EXEC_WORKER_CONCURRENCY=3
CODE_EXEC_CONTAINER_CPUS=1
CODE_EXEC_CONTAINER_PIDS_LIMIT=64
TEST_GRADING_WORKER_CONCURRENCY=15
PROCTOR_ANALYSIS_WAIT_TIMEOUT_MS=8000
# Async I/O concurrency (waiting on the Python CV HTTP call), not CPU-bound —
# safe to leave high even on a small box.
PROCTOR_ANALYSIS_WORKER_CONCURRENCY=400

# ==================== CANDIDATE SCORE WEBHOOK ====================
CANDIDATE_SCORE_WEBHOOK_URL="REPLACE_ME_YOUR_REAL_WEBHOOK_ENDPOINT"
CANDIDATE_SCORE_WEBHOOK_TIMEOUT_MS=5000

# ==================== FILE STORAGE ====================
FILE_STORAGE_MODE="filesystem"
FILE_STORAGE_PATH="/var/lib/talentq/storage"
CANDIDATE_DATA_DIR_NAME="Candidate Data"
QUESTION_BANK_DIR_NAME="Question Bank"

# ==================== AUDIO VIOLATION THRESHOLDS ====================
AUDIO_WARNING_LEVEL=42
AUDIO_CRITICAL_LEVEL=58
AUDIO_VOICE_MIN_LEVEL=16

# ==================== LLM (Anthropic) ====================
LLM_PROVIDER="anthropic"
LLM_API_KEY="REPLACE_ME_PRODUCTION_ANTHROPIC_KEY"

# ==================== PROCTORING ====================
DEFAULT_MAX_VIOLATIONS=5
FACE_DETECTION_INTERVAL_MS=2000
SNAPSHOT_INTERVAL_MS=30000
RECORDING_CHUNK_SIZE_MS=10000
PROCTOR_AUTO_FLAG_ON_CRITICAL=false
PROCTOR_SESSION_MIN_INTERVAL_MS=4000
PROCTOR_MAX_CONCURRENT_RECORDING_UPLOADS=30
PROCTOR_ALLOWED_EVENTS=multiple_faces,phone_detected,face_not_detected,voice_detected,tab_switch,fullscreen_exit,window_blur,copy_paste_attempt,devtools_open,camera_blocked,looking_away,suspicious_audio,unauthorized_object_detected
PROCTOR_REPORT_EVENTS=phone_detected,multiple_faces,looking_away,voice_detected,suspicious_audio,unauthorized_object_detected
PROCTOR_PROFILE="performance"
PROCTOR_TRACE=false

# ==================== ID VERIFICATION (CompreFace) ====================
# The current dev instance is an external IP (168.144.150.159) — confirm this
# is a persistent, production-grade instance reachable from the droplet, or
# self-host CompreFace via Docker instead.
VERIFICATION_PROVIDER="compreface"
COMPREFACE_BASE_URL="REPLACE_ME_PRODUCTION_COMPREFACE_URL"
COMPREFACE_API_KEY="REPLACE_ME"
COMPREFACE_DET_PROB_THRESHOLD=0.9
VERIFICATION_FACE_MATCH_THRESHOLD=85

# ==================== PYTHON CV SERVICE ====================
# Update the host if the Python CV service doesn't run on the same droplet.
PYTHON_CV_SERVICE_URL="http://127.0.0.1:8010"
PYTHON_CV_TIMEOUT_MS=10000
PYTHON_CV_RETRY_COUNT=0
PYTHON_CV_RETRY_DELAY_MS=200
PYTHON_CV_CIRCUIT_FAILURES=6
PYTHON_CV_CIRCUIT_OPEN_MS=45000

# ==================== GEMMA PROCTORING VERIFIER (optional) ====================
# Same external-IP concern as CompreFace above — confirm production-readiness.
GEMMA_PROCTOR_ENABLED=true
GEMMA_PROCTOR_URL="REPLACE_ME_PRODUCTION_GEMMA_URL"
GEMMA_PROCTOR_API_KEY="REPLACE_ME"
GEMMA_PROCTOR_TIMEOUT_MS=25000
GEMMA_PROCTOR_CONFIRM_THRESHOLD=75

# ==================== RESULT WEBHOOK ====================
WEBHOOK_URL="REPLACE_ME_YOUR_REAL_RESULTS_WEBHOOK"
WEBHOOK_SECRET="REPLACE_ME_GENERATE_NEW_RANDOM_SECRET"

# ==================== EMAIL (Resend) ====================
MAIL_PROVIDER=resend
RESEND_API_KEY="REPLACE_ME_PRODUCTION_RESEND_KEY"
RESEND_FROM="REPLACE_ME_A_VERIFIED_SENDING_ADDRESS@yourdomain.com"
