generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionSource {
  QUESTION_BANK
  CUSTOM
}

enum QuestionRepositoryCategory {
  CODING
  MCQ
  BEHAVIORAL
  COMMUNICATION
}

enum CommunicationSubType {
  WRITTEN
  LISTENING
  READING
  SPEAKING
}

enum WrittenStimulusType {
  NONE
  IMAGE
  AUDIO
}

enum InvitationStatus {
  PENDING
  SENT
  FAILED
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  companyId String?
  externalProvider String?
  externalUserId String?
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Force-logout: any JWT with iat before this timestamp is rejected by
  // adminAuth, regardless of its own expiry. Set by the superadmin
  // "kill session" action — kills every device/tab at once.
  tokensValidAfter DateTime?

  // Persistent login lockout (on top of the IP-based rate limiter).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Security-driven lock (anomaly detection or manual superadmin action).
  // Distinct from AdminBilling.status='suspended', which only blocks
  // billed actions — this blocks the account entirely.
  securityLocked       Boolean  @default(false)
  securityLockReason   String?
  securityLockedAt     DateTime?

  // Soft-delete grace period. While pendingDeletionAt is set and in the
  // future, the account still works normally; a scheduled job performs the
  // real cascade-delete once it elapses. Superadmin can cancel any time
  // before then.
  pendingDeletionAt          DateTime?
  deletionReason             String?
  deletionScheduledByEmail   String?

  company   Company? @relation(fields: [companyId], references: [id])
  sessions  AuthSession[]
  tests     Test[]
  mcqQuestions    MCQQuestion[]
  codingQuestions CodingQuestion[]
  behavioralQuestions BehavioralQuestion[]
  actionLogs  AdminActionLog[]
  auditLogs   AuditLog[]
  clickEvents AdminClickEvent[]
  billing     AdminBilling?
  communicationQuestions CommunicationQuestion[]
  readingPassages ReadingPassage[]

  @@index([companyId])
  @@index([resetPasswordTokenHash])
  @@unique([externalProvider, externalUserId])
}

model Company {
  id                String   @id @default(uuid())
  externalCompanyId String   @unique
  name              String
  webhookUrl        String?
  webhookSecret     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  admins     Admin[]
  tests      Test[]
  candidates Candidate[]
}

// One row per recruitment-platform partner integrated via /api/integration.
// Lets each partner sign recruiter JWTs with its own secret/issuer instead of
// sharing a single set of RECRUITER_JWT_* env vars across every client.
model IntegrationPartner {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  jwtSecret String
  jwtIssuer String?
  jwtAudience String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jwtIssuer])
}

model IntegrationAuditLog {
  id           String   @id @default(uuid())
  companyId    String?
  actorId      String
  actorEmail   String?
  action       String
  method       String
  path         String
  statusCode   Int?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  adminId          String
  refreshTokenHash String    @unique
  scopes           String    @default("[]")
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Candidate {
  id           String             @id @default(uuid())
  email        String
  name         String
  password     String?
  companyId    String?
  createdAt    DateTime           @default(now())
  testAttempts TestAttempt[]
  identity     CandidateIdentity?
  company      Company?           @relation(fields: [companyId], references: [id])

  @@unique([email])
  @@index([companyId])
}

model Test {
  id                    String    @id @default(uuid())
  testCode              String    @unique
  name                  String
  description           String?
  instructions          String?
  duration              Int // in minutes
  startTime             DateTime
  endTime               DateTime?
  totalMarks            Int
  passingMarks          Int?
  negativeMarking       Float     @default(0)
  isActive              Boolean   @default(true)
  shuffleQuestions      Boolean   @default(false)
  shuffleOptions        Boolean   @default(false)
  allowMultipleAttempts Boolean   @default(false)
  maxViolations         Int       @default(3)
  // Set true only by the AI test-generation flow (testAgent.ts) — lets the
  // billing subsystem count AI generations distinctly from manually-created
  // tests without a separate log table.
  isAiGenerated         Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Proctoring settings
  proctorEnabled        Boolean @default(false)
  requireCamera         Boolean @default(false)
  requireMicrophone     Boolean @default(false)
  requireScreenShare    Boolean @default(false)
  requireIdVerification Boolean @default(false)
  // Per-test auto-approve gate: when on, a face-match score at/above the threshold
  // below auto-verifies the candidate instead of routing to the admin queue.
  autoApproveId          Boolean @default(false)
  idVerificationAutoApproveThreshold Float?
  allowMobileProctoring Boolean @default(false)
  customAIViolations    String? // JSON array of enabled proctoring violation event types

  // Email templates ({{candidate_name}}, {{test_name}}, {{company_name}}, {{estimated_time}}, {{test_link}})
  inviteEmailSubject    String?
  inviteEmailBody       String?
  confirmEmailSubject   String?
  confirmEmailBody      String?
  reminderEmailSubject  String?
  reminderEmailBody     String?
  // Hours before endTime the reminder sweep emails candidates who haven't started yet
  reminderHoursBeforeClose Int @default(24)

  questions TestQuestion[]
  sections  TestSection[]
  attempts  TestAttempt[]
  analytics TestAnalytics?
  invitations TestInvitation[]

  @@index([companyId])
}

model TestInvitation {
  id        String           @id @default(uuid())
  testId    String
  name      String
  email     String
  phone     String?
  token     String           @unique
  accessCode String?         @unique
  status    InvitationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  consumedAt DateTime?
  reminderSentAt DateTime?
  createdAt DateTime         @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([email])
  @@unique([testId, email])
}

model MCQQuestion {
  id String @id @default(uuid())

  // Repository classification
  source             QuestionSource             @default(CUSTOM)
  repositoryCategory QuestionRepositoryCategory @default(MCQ)
  isEnabled          Boolean                    @default(true)

  questionText     String
  options          String // JSON array
  correctAnswers   String // JSON array
  marks            Int
  isMultipleChoice Boolean @default(false)
  explanation      String?

  difficulty String  @default("medium")
  topic      String?
  tags       String? // JSON array of skills

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id])

  mediaAssets   MediaAsset[]
  testQuestions TestQuestion[]
  answers       MCQAnswer[]

  @@index([source])
  @@index([repositoryCategory])
  @@index([difficulty])
  @@index([isEnabled])
  @@index([adminId])
}

model CodingQuestion {
  id String @id @default(uuid())

  // Repository classification
  source             QuestionSource             @default(CUSTOM)
  repositoryCategory QuestionRepositoryCategory @default(CODING)
  isEnabled          Boolean                    @default(true)

  title        String
  description  String
  inputFormat  String
  outputFormat String
  constraints  String?
  sampleInput  String
  sampleOutput String

  marks       Int
  timeLimit   Int @default(2000)
  memoryLimit Int @default(256)

  supportedLanguages String // JSON array
  codeTemplates      String?
  partialScoring     Boolean @default(false)

  difficulty String  @default("medium")
  topic      String?
  tags       String?

  autoEvaluate Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id])

  testCases     TestCase[]
  testQuestions TestQuestion[]
  answers       CodingAnswer[]

  @@index([source])
  @@index([repositoryCategory])
  @@index([difficulty])
  @@index([isEnabled])
  @@index([adminId])
}

model BehavioralQuestion {
  id String @id @default(uuid())

  // Repository classification
  source             QuestionSource             @default(CUSTOM)
  repositoryCategory QuestionRepositoryCategory @default(BEHAVIORAL)
  isEnabled          Boolean                    @default(true)

  title       String
  description String

  marks Int

  difficulty String  @default("medium")
  topic      String?
  tags       String?

  expectedAnswer String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id])

  testQuestions TestQuestion[]
  answers       BehavioralAnswer[]

  @@index([source])
  @@index([repositoryCategory])
  @@index([difficulty])
  @@index([isEnabled])
  @@index([adminId])
}

model ReadingPassage {
  id          String   @id @default(uuid())
  title       String
  passageText String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id])

  questions CommunicationQuestion[]

  @@index([adminId])
}

model CommunicationQuestion {
  id String @id @default(uuid())

  // Repository classification
  source             QuestionSource             @default(CUSTOM)
  repositoryCategory QuestionRepositoryCategory @default(COMMUNICATION)
  isEnabled          Boolean                    @default(true)
  subType            CommunicationSubType

  // Shared fields
  title       String
  description String? // prompt (Written/Listening) or topic text (Speaking); unused for Reading (passage carries text)
  marks       Int
  difficulty  String  @default("medium")
  topic       String?
  tags        String? // JSON array

  // Written-only
  stimulusType    WrittenStimulusType? // NONE | IMAGE | AUDIO — recruiter's per-question choice
  evaluationNotes String? // optional extra grading rubric beyond title+description

  // Listening & Reading (MCQ-shaped)
  options          String? // JSON array
  correctAnswers   String? // JSON array
  explanation      String?
  isMultipleChoice Boolean @default(false)

  // Listening-only guardrails
  replayLimit        Int?     @default(1)
  allowRewind        Boolean? @default(true)
  allowSpeedChange   Boolean? @default(true)
  fixedPlaybackSpeed Float?   @default(1.0) // used when allowSpeedChange = false

  // Reading-only
  passageId String?
  passage   ReadingPassage? @relation(fields: [passageId], references: [id])

  // Speaking-only
  recordingTimeLimit Int? // seconds
  retakeLimit        Int? // max re-records allowed; null/unset = unlimited

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id])

  mediaAssets   MediaAsset[]
  testQuestions TestQuestion[]
  answers       CommunicationAnswer[]

  @@index([source])
  @@index([repositoryCategory])
  @@index([subType])
  @@index([difficulty])
  @@index([isEnabled])
  @@index([adminId])
  @@index([passageId])
}

model TestCase {
  id             String  @id @default(uuid())
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  marks          Int     @default(0)

  questionId String
  question   CodingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestQuestion {
  id String @id @default(uuid())

  testId       String
  questionType String // "mcq", "coding", "behavioral", "communication"

  sectionId String?

  mcqQuestionId           String?
  codingQuestionId        String?
  behavioralQuestionId    String?
  communicationQuestionId String?

  orderIndex Int

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  section TestSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  mcqQuestion           MCQQuestion?           @relation(fields: [mcqQuestionId], references: [id])
  codingQuestion        CodingQuestion?        @relation(fields: [codingQuestionId], references: [id])
  behavioralQuestion    BehavioralQuestion?    @relation(fields: [behavioralQuestionId], references: [id])
  communicationQuestion CommunicationQuestion? @relation(fields: [communicationQuestionId], references: [id])

  attemptQuestions TestAttemptQuestion[]

  @@unique([testId, orderIndex])
}

model TestSection {
  id String @id @default(uuid())

  testId   String
  name     String
  orderIndex Int
  questionsPerCandidate Int @default(1)

  test      Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions TestQuestion[]

  @@unique([testId, orderIndex])
  @@index([testId])
}

model TestAttempt {
  id          String    @id @default(uuid())
  testId      String
  candidateId String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  submittedAt DateTime?
  status      String    @default("in_progress") // in_progress, submitted, auto_submitted, flagged
  score       Float?
  violations  Int       @default(0)
  isFlagged   Boolean   @default(false)
  flagReason  String?
  reviewed    Boolean   @default(false)
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNotes String?

  resultReleased    Boolean   @default(true)
  releasedAt        DateTime?
  releasedBy        String?
  resultEmailSentAt DateTime?

  // Updated by a periodic client heartbeat while the exam tab is open; lets the expiry
  // sweep detect an abandoned attempt (tab closed, crash, network loss) and auto-submit
  // it well before the full test duration would otherwise elapse.
  lastSeenAt DateTime?

  test      Test      @relation(fields: [testId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  mcqAnswers           MCQAnswer[]
  codingAnswers        CodingAnswer[]
  behavioralAnswers    BehavioralAnswer[]
  communicationAnswers CommunicationAnswer[]
  activityLogs         ActivityLog[]
  attemptQuestions     TestAttemptQuestion[]

  // Proctoring and Analytics relations
  proctorSession ProctorSession?
  analytics      PerformanceAnalytics?

  @@unique([testId, candidateId])
}

model TestAttemptQuestion {
  id String @id @default(uuid())

  attemptId      String
  testQuestionId String
  orderIndex     Int

  attempt      TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testQuestion TestQuestion @relation(fields: [testQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, testQuestionId])
  @@unique([attemptId, orderIndex])
  @@index([attemptId])
}

model MCQAnswer {
  id              String   @id @default(uuid())
  attemptId       String
  questionId      String
  selectedOptions String // JSON array of selected option indices
  isCorrect       Boolean?
  marksObtained   Float?
  answeredAt      DateTime @default(now())

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question MCQQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model CodingAnswer {
  id            String   @id @default(uuid())
  attemptId     String
  questionId    String
  code          String
  language      String
  testResults   String? // JSON array of test results
  marksObtained Float?
  executionTime Int?
  memoryUsed    Int?
  submittedAt   DateTime @default(now())

  attempt  TestAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question CodingQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model BehavioralAnswer {
  id            String   @id @default(uuid())
  attemptId     String
  questionId    String
  answerText    String
  marksObtained Float?
  submittedAt   DateTime @default(now())

  attempt  TestAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question BehavioralQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model CommunicationAnswer {
  id         String @id @default(uuid())
  attemptId  String
  questionId String

  answerText      String? // Written typed response
  selectedOptions String? // JSON — Listening/Reading MCQ selection
  audioAssetId    String? // Speaking recording (via MediaAsset)
  transcript      String? // Speaking — Whisper output
  replayCount     Int?    @default(0) // Listening — guardrail telemetry
  retakeCount     Int?    @default(0) // Speaking — guardrail telemetry

  isCorrect     Boolean? // Listening/Reading
  marksObtained Float?
  gradingDetail String? // JSON — {contentScore, fluencyScore, pronunciationScore, cefrLevel, reasoning}

  submittedAt DateTime @default(now())

  attempt  TestAttempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question CommunicationQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  attemptId String
  eventType String // login, test_start, tab_switch, focus_loss, fullscreen_exit, etc.
  eventData String? // JSON for additional data
  timestamp DateTime @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

// ==================== PROCTORING MODELS ====================

model ProctorSession {
  id        String      @id @default(uuid())
  attemptId String      @unique
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Session status
  cameraEnabled      Boolean @default(false)
  microphoneEnabled  Boolean @default(false)
  screenShareEnabled Boolean @default(false)

  // Device info
  browserInfo       String? // JSON: { name, version, os }
  screenResolution  String? // "1920x1080"
  deviceFingerprint String? // Unique device identifier
  ipAddress         String?
  sessionMetadata   Json? // Canonical session metadata blob

  // Auxiliary device tracking
  mobileDeviceId String? // For mobile pairing
  mobileVerified Boolean @default(false)

  // External monitor detection
  monitorCount            Int     @default(1)
  externalMonitorDetected Boolean @default(false)

  // Face verification status
  faceVerified   Boolean @default(false)
  faceMatchScore Float? // 0-100 confidence score

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Relations
  events        ProctorEvent[]
  recordings    ProctorRecording[]
  faceSnapshots FaceSnapshot[]
  telemetry     ProctorTelemetry[]
}

model ProctorEvent {
  id        String         @id @default(uuid())
  sessionId String
  session   ProctorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  eventType  String // face_not_detected, multiple_faces, looking_away, audio_anomaly,
  // phone_detected, external_monitor, screen_switch, tab_change,
  // copy_paste, devtools_open, screen_share_stopped, suspicious_audio
  severity   String @default("medium") // low, medium, high, critical
  confidence Float? // AI confidence score 0-100

  // Event details
  description String?
  metadata    String? // JSON for additional context

  // Evidence
  snapshotUrl  String? // URL to captured frame/screenshot
  audioClipUrl String? // URL to audio clip if relevant

  // Timestamps
  timestamp DateTime @default(now())
  duration  Int? // Duration of violation in ms (for continuous events)

  // Admin review
  reviewed    Boolean   @default(false)
  reviewedAt  DateTime?
  reviewedBy  String? // Admin ID
  reviewNotes String?
  dismissed   Boolean   @default(false) // If admin marks as false positive
}

model ProctorRecording {
  id        String         @id @default(uuid())
  sessionId String
  session   ProctorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  recordingType String // webcam, screen, audio, combined
  storageUrl    String // URL to stored video/audio file
  storageBucket String? // Storage bucket name
  storageKey    String? // Object key in storage

  startTime DateTime
  endTime   DateTime?
  duration  Int? // Duration in seconds
  fileSize  Int? // Size in bytes
  mimeType  String? // video/webm, audio/webm, etc.

  // Processing status
  status          String  @default("recording") // recording, uploading, processing, ready, failed
  processingError String?

  // Violation clips extracted from this recording
  violationClips ViolationClip[]

  createdAt DateTime @default(now())
}

model ProctorTelemetry {
  id        String         @id @default(uuid())
  sessionId String
  session   ProctorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  source  String @default("analysis") // analysis, violation_report, engine_event
  payload Json

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model ViolationClip {
  id          String           @id @default(uuid())
  recordingId String
  recording   ProctorRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  clipUrl       String // URL to the specific violation clip
  startOffset   Int // Start time offset in ms from recording start
  endOffset     Int // End time offset in ms
  violationType String // Type of violation captured
  description   String?

  createdAt DateTime @default(now())
}

model FaceSnapshot {
  id        String         @id @default(uuid())
  sessionId String
  session   ProctorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  imageUrl   String // URL to face snapshot
  purpose    String // verification, periodic_check, violation_evidence
  matchScore Float? // Face match score compared to reference
  faceCount  Int? // Number of faces detected

  // Face analysis results
  gazeDirection String? // JSON: { x, y, z } or "looking_away", "looking_at_screen"
  emotionData   String? // JSON: { emotion: confidence }

  capturedAt DateTime @default(now())
}

// ==================== ID VERIFICATION MODELS ====================

model CandidateIdentity {
  id          String    @id @default(uuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // ID Document
  idDocumentType   String? // national_id, passport, drivers_license, student_id
  idDocumentUrl    String? // URL to uploaded ID document
  idDocumentNumber String? // Encrypted document number

  // Face reference for proctoring
  faceReferenceUrl String? // Reference photo for face matching

  // Verification status
  verificationStatus String    @default("pending") // pending, verified, rejected, expired
  verifiedAt         DateTime?
  verifiedBy         String? // Admin ID or "ai_auto_verified"
  rejectionReason    String?

  // AI verification scores
  documentAuthScore Float? // Document authenticity score 0-100
  faceMatchScore    Float? // Face match with ID photo score 0-100
  livenessScore     Float? // Liveness detection score 0-100

  // Metadata
  verificationAttempts Int       @default(0)
  lastAttemptAt        DateTime?
  expiresAt            DateTime? // When verification expires

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== MEDIA MODELS FOR MCQ ====================

model MediaAsset {
  id String @id @default(uuid())

  // File info
  filename     String
  originalName String
  mimeType     String // image/png, video/mp4, audio/mp3, etc.
  fileSize     Int // Size in bytes

  // Storage
  storageUrl    String // Full URL to access
  storageBucket String? // Bucket name
  storageKey    String // Object key in storage

  // Media type
  mediaType String // image, video, audio

  // Dimensions (for images/videos)
  width    Int?
  height   Int?
  duration Int? // Duration in seconds for audio/video

  // Thumbnails
  thumbnailUrl String?

  // Processing
  status          String  @default("uploaded") // uploaded, processing, ready, failed
  processingError String?

  // Relations
  mcqQuestionId String?
  mcqQuestion   MCQQuestion? @relation(fields: [mcqQuestionId], references: [id], onDelete: SetNull)

  communicationQuestionId String?
  communicationQuestion   CommunicationQuestion? @relation(fields: [communicationQuestionId], references: [id], onDelete: SetNull)

  // Metadata
  uploadedBy String? // Admin ID
  createdAt  DateTime @default(now())
}

// ==================== PERFORMANCE ANALYTICS MODELS ====================

model PerformanceAnalytics {
  id        String      @id @default(uuid())
  attemptId String      @unique
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Overall metrics
  totalScore   Float
  percentile   Float? // Percentile rank among all attempts
  overallGrade String? // A, B, C, D, F or custom grades

  // Time analysis
  totalTimeTaken         Int // Total time in seconds
  averageTimePerQuestion Int? // Average time per question in seconds

  // Difficulty breakdown
  easyCorrect    Int    @default(0)
  easyTotal      Int    @default(0)
  easyAccuracy   Float?
  mediumCorrect  Int    @default(0)
  mediumTotal    Int    @default(0)
  mediumAccuracy Float?
  hardCorrect    Int    @default(0)
  hardTotal      Int    @default(0)
  hardAccuracy   Float?

  // Topic-wise performance (JSON)
  topicAnalysis String? // JSON: { "topic1": { correct: 5, total: 10, accuracy: 50 }, ... }

  // Tag/Skill analysis (JSON)
  skillAnalysis String? // JSON: { "skill1": { correct: 3, total: 5, accuracy: 60 }, ... }

  // AI-generated insights
  aiInsights      String? // AI-generated analysis text
  strengths       String? // JSON array of identified strengths
  weaknesses      String? // JSON array of identified weaknesses
  recommendations String? // JSON array of recommendations

  // Proctoring summary
  proctoringSummary String? // JSON: { totalViolations, violationTypes, riskScore }
  trustScore        Float? // Overall trust/integrity score 0-100

  // Coding-specific metrics (if applicable)
  codingMetrics String? // JSON: { avgExecutionTime, avgMemory, passRate, codeQuality }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestAnalytics {
  id     String @id @default(uuid())
  testId String @unique
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  // Participation metrics
  totalAttempts     Int    @default(0)
  completedAttempts Int    @default(0)
  averageScore      Float?
  medianScore       Float?
  highestScore      Float?
  lowestScore       Float?
  passRate          Float?

  // Time metrics
  averageTimeTaken  Int? // In seconds
  fastestCompletion Int?
  slowestCompletion Int?

  // Question difficulty analysis
  questionDifficulty String? // JSON: { "questionId": { attempts, correct, difficulty } }

  // Proctoring summary
  totalViolations   Int    @default(0)
  flaggedAttempts   Int    @default(0)
  averageTrustScore Float?

  // Distribution data for charts
  scoreDistribution String? // JSON: { "0-10": 5, "11-20": 10, ... }
  timeDistribution  String? // JSON: distribution of completion times

  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==================== FILE STORAGE IN POSTGRESQL ====================

model FileStorage {
  id String @id @default(uuid())

  // File metadata
  filename     String // Generated filename
  originalName String // Original filename from upload
  mimeType     String // image/png, video/webm, audio/mp3, etc.
  fileSize     Int // Size in bytes

  // File data stored directly in PostgreSQL
  data Bytes // Binary file data

  // Categorization
  category String // recording, snapshot, mcq_media, id_document, violation_clip

  // Reference IDs (one will be set based on category)
  attemptId   String? // For recordings, snapshots
  questionId  String? // For MCQ media
  candidateId String? // For ID documents
  sessionId   String? // For proctoring data

  // Additional metadata
  metadata String? // JSON for extra info (dimensions, duration, etc.)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([category])
  @@index([attemptId])
  @@index([questionId])
  @@index([candidateId])
  @@index([sessionId])
}

// ===================== Superadmin Observer =====================

model SuperAdmin {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // full_control: everything. read_only: every GET works, every mutating
  // route is rejected by requireFullControl — lets a second person watch
  // without being able to delete accounts, toggle locks, etc.
  role String @default("full_control")

  tokensValidAfter DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  totpSecret  String?
  totpEnabled Boolean @default(false)

  sessions SuperAdminSession[]
}

// Mirrors AuthSession (used today by the integration/recruiter refresh
// flow) but scoped to SuperAdmin, which isn't an Admin row.
model SuperAdminSession {
  id               String    @id @default(uuid())
  superAdminId     String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
}

// One row per (owner, device) fingerprint ever seen at login — first sight
// of a new one triggers a "new device/IP" alert.
model LoginDeviceFingerprint {
  id              String   @id @default(uuid())
  ownerType       String // admin | superadmin
  ownerId         String
  fingerprintHash String
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@unique([ownerType, ownerId, fingerprintHash])
}

model SuperAdminIpAllowlistEntry {
  id             String   @id @default(uuid())
  cidrOrIp       String
  label          String?
  createdAt      DateTime @default(now())
  createdByEmail String?
}

// Singleton (key="global") toggle for the superadmin login IP allowlist.
// Defaults OFF — enabling it without at least one allowlist entry covering
// your own current IP would lock you out, so the login/toggle endpoint
// refuses to enable it if the caller's own IP isn't already listed.
model SecuritySettings {
  id                 String   @id @default(uuid())
  key                String   @unique
  ipAllowlistEnabled Boolean  @default(false)
  updatedByEmail     String?
  updatedAt          DateTime @updatedAt
}

model AlertConfig {
  id                       String   @id @default(uuid())
  key                      String   @unique
  enabled                  Boolean  @default(false)
  emailTo                  String?
  slackWebhookUrl          String?
  genericWebhookUrl        String?
  apiLatencyP95ThresholdMs Int?
  sustainedMinutes         Int      @default(5)
  updatedByEmail           String?
  updatedAt                DateTime @updatedAt
}

model AlertLog {
  id           String   @id @default(uuid())
  type         String
  severity     String // info | warning | critical
  message      String
  meta         Json?
  delivered    Boolean  @default(false)
  deliveryError String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

// Maintains the running tip of the AuditLog hash chain (see AuditLog.hash).
// Kept as its own singleton row rather than re-querying "the last AuditLog
// row" so the chain update can happen inside the same transaction as the
// AuditLog insert without a race between concurrent writers.
model AuditChainState {
  id       String  @id @default(uuid())
  key      String  @unique
  lastHash String?
}

// Server-guaranteed log of every authenticated admin API request.
// adminId is intentionally nullable/SetNull (not Cascade): deleting an
// admin must not erase the oversight record of what that admin did.
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String
  adminName  String
  method     String
  path       String
  statusCode Int
  durationMs Int
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// Before/after diff log for mutating admin actions (the "what changed" trail).
model AuditLog {
  id           String   @id @default(uuid())
  actorAdminId String?
  actorAdmin   Admin?   @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)
  actorEmail   String
  action       String // create | update | delete
  resourceType String
  resourceId   String?
  // Encrypted (AES-256-GCM) when AUDIT_ENCRYPTION_KEY is configured — shape
  // is then { enc: "<base64 ciphertext>" } instead of the raw diff. Falls
  // back to plaintext (with a startup warning) if no key is configured.
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  // Tamper-evident hash chain — see AuditChainState. prevHash/hash are
  // nullable so historical rows predating this feature don't need a
  // backfill; the verifier treats the first hashed row as the chain start.
  prevHash String?
  hash     String?

  @@index([actorAdminId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// Client-reported UI click/navigation stream, supplementing AdminActionLog
// with interactions that don't hit the network (opening a modal, etc).
model AdminClickEvent {
  id              String   @id @default(uuid())
  adminId         String?
  admin           Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail      String
  sessionId       String
  eventType       String
  targetLabel     String?
  targetSelector  String?
  route           String?
  metadata        Json?
  clientTimestamp DateTime
  receivedAt      DateTime @default(now())

  @@index([adminId])
  @@index([receivedAt])
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  label          String
  description    String?
  enabled        Boolean  @default(true)
  updatedByEmail String?
  updatedAt      DateTime @updatedAt
}

// Per-admin exception to a FeatureFlag's global enabled/disabled value --
// e.g. a feature can be globally enabled but disabled for one specific
// account (or vice versa). Absence of a row here means "follow the global
// FeatureFlag.enabled value"; see requireFeatureEnabled() in featureLock.ts.
model FeatureFlagOverride {
  id             String   @id @default(uuid())
  featureKey     String
  adminId        String
  enabled        Boolean
  updatedByEmail String?
  updatedAt      DateTime @updatedAt

  @@unique([featureKey, adminId])
  @@index([adminId])
}

// Periodic rollup of live telemetry (ping, proctoring fps, CV latency,
// failed-request rate) for historical charts. "Live" numbers themselves
// are served from an in-memory ring buffer, not this table.
model TelemetrySnapshot {
  id                   String   @id @default(uuid())
  capturedAt           DateTime @default(now())
  activeSessions       Int
  medianPingMs         Float?
  refreshFps           Float?
  cvLatencyP50Ms       Float?
  cvLatencyP95Ms       Float?
  failedRequestRatePct Float?
  regionBreakdown      Json?
  // Overall application smoothness: real admin-API response times (not
  // just proctoring/CV calls) and real browser rendering frame rate,
  // reported by admin tabs via a requestAnimationFrame loop.
  apiLatencyP50Ms      Float?
  apiLatencyP95Ms      Float?
  appFps               Float?

  @@index([capturedAt])
}

// ==================== BILLING (superadmin-managed, preview) ====================
// The whole billing subsystem is gated by BillingSettings.enabled (a single
// row, checked by the billingGate middleware before any quota is enforced).
// When disabled — the default — every quota check is a no-op and the app
// behaves exactly as it did before this subsystem existed. This is
// deliberate: billing is not yet board-approved and must be a fully inert,
// zero-risk toggle until it is switched on.

model BillingPlan {
  id                      String   @id @default(uuid())
  key                     String   @unique
  label                   String
  description             String?
  priceMonthly            Float?
  // null = unlimited for any of the limits below
  maxTests                Int?
  maxAiGenerations        Int?
  maxInvitationsPerCycle  Int?
  maxConcurrentProctoring Int?
  maxCustomQuestions      Int?
  maxStorageMb            Int?
  isCustom                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  subscriptions AdminBilling[]
}

// One row per Admin (billing is scoped to the individual exam-portal admin,
// matching how every other superadmin screen — accounts, action log,
// feature flags — is already scoped to Admin rather than Company).
model AdminBilling {
  id                 String    @id @default(uuid())
  adminId            String    @unique
  admin              Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  planId             String
  plan               BillingPlan @relation(fields: [planId], references: [id])
  status             String    @default("active") // active | trialing | suspended | cancelled
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  addOnAiGenerations Int       @default(0)
  overrideNote       String?
  suspendedAt        DateTime?
  suspendedReason    String?
  updatedByEmail     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invoices BillingInvoice[]

  @@index([planId])
  @@index([status])
}

// Manual billing/payment record — this build does not integrate a live
// payment processor (no Stripe/Razorpay credentials exist yet), so invoices
// are recorded by the superadmin rather than generated from webhooks. The
// schema is shaped so a real processor could be wired in later without a
// migration (add a `providerRef` column and start writing rows from a
// webhook handler instead of the manual-entry endpoint).
model BillingInvoice {
  id             String   @id @default(uuid())
  adminBillingId String
  adminBilling   AdminBilling @relation(fields: [adminBillingId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String   @default("USD")
  status         String // paid | pending | failed | manual
  note           String?
  issuedAt       DateTime @default(now())
  createdByEmail String?

  @@index([adminBillingId])
  @@index([issuedAt])
}

// Singleton row (key = "global") — the master enable/disable switch for the
// entire billing subsystem.
model BillingSettings {
  id             String   @id @default(uuid())
  key            String   @unique
  enabled        Boolean  @default(false)
  updatedByEmail String?
  updatedAt      DateTime @updatedAt
}
