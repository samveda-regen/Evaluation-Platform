<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ==================== ENTRY POINT ==================== -->
  <!-- Personalized for one invite token. Delete this file (or regenerate
       the invite) once this test session is used, since it embeds a
       live credential in plaintext. -->
  <key>startURL</key>
  <string>https://experiment.talentstaq.ai/test/login?token=70415625d7393d75c6c4b78c3b42cde067f00685d9ab0743a6699f4dfe0b05a8</string>

  <!-- ==================== WINDOW / KIOSK MODE ==================== -->
  <key>browserViewMode</key>
  <integer>1</integer> <!-- 1 = fullscreen kiosk -->
  <key>allowBrowsingBackForward</key>
  <false/>
  <key>browserWindowAllowReload</key>
  <false/>
  <key>showReloadWarning</key>
  <true/>
  <key>newBrowserWindowByLinkPolicy</key>
  <integer>0</integer> <!-- block links opening new windows -->
  <key>newBrowserWindowByScriptPolicy</key>
  <integer>0</integer>
  <key>enableBrowserWindowToolbar</key>
  <false/>
  <key>hideBrowserWindowToolbar</key>
  <true/>
  <key>showMenuBar</key>
  <false/>
  <key>showTaskBar</key>
  <true/>
  <key>showTime</key>
  <true/>
  <key>allowedDisplaysMaxNumber</key>
  <integer>1</integer> <!-- blocks a second monitor -->

  <!-- ==================== QUIT / EXIT ==================== -->
  <!-- Per your call: no quit password, candidates can exit normally. -->
  <key>allowQuit</key>
  <true/>
  <key>quitURLConfirm</key>
  <true/>
  <key>hashedQuitPassword</key>
  <string></string>

  <!-- ==================== URL WHITELIST ==================== -->
  <!-- Frontend, backend API, and websocket (Socket.io) all live on the
       same origin per your setup, so a single rule covers all of it.
       The Python CV proctoring service and CompreFace are called
       server-to-server by the backend, never directly from the
       candidate's browser, so they do NOT need to be whitelisted here. -->
  <key>URLFilterEnable</key>
  <true/>
  <key>URLFilterEnableContentFilter</key>
  <true/>
  <key>urlFilterRules</key>
  <array>
    <dict>
      <key>action</key>
      <integer>1</integer> <!-- 1 = allow -->
      <key>active</key>
      <true/>
      <key>regex</key>
      <true/>
      <key>expression</key>
      <string>^https://experiment\.talentstaq\.ai(/.*)?$</string>
    </dict>
    <dict>
      <key>action</key>
      <integer>1</integer>
      <key>active</key>
      <true/>
      <key>regex</key>
      <true/>
      <key>expression</key>
      <string>^wss://experiment\.talentstaq\.ai(/.*)?$</string>
    </dict>
  </array>

  <!-- ==================== CAMERA / MIC ACCESS ==================== -->
  <!-- REQUIRED: your webcam + audio proctoring (WebcamCapture.tsx,
       useProctoring.ts) uses getUserMedia in-browser. SEB blocks media
       capture by default. The two keys below are what recent SEB
       versions (Win 3.3+/Mac 3.0+) use to permit it, but I'm not fully
       certain these exact key names match your candidate's installed
       SEB version — this is the #1 thing to watch for in this test run.
       If camera access silently fails, your whole proctoring pipeline
       goes dark for that session. -->
  <key>allowAudioCapture</key>
  <true/>
  <key>allowVideoCapture</key>
  <true/>

  <!-- ==================== LOCKDOWN HARDENING ==================== -->
  <key>allowVirtualMachine</key>
  <false/>
  <key>allowScreenSharing</key>
  <false/>
  <key>allowSiri</key>
  <false/>
  <key>allowDictation</key>
  <false/>
  <key>allowSpellCheck</key>
  <false/>
  <key>allowDictionaryLookup</key>
  <false/>
  <key>allowWLAN</key>
  <false/>
  <key>enableAppSwitcherCheck</key>
  <true/>
  <key>forceAppFolderInstall</key>
  <true/>

  <!-- Known remote-access / screen-capture / VM tools to kill or block
       from launching during the exam. Extend this list for your own
       environment before relying on it as the sole control. -->
  <key>prohibitedProcesses</key>
  <array>
    <dict>
      <key>active</key><true/>
      <key>currentUser</key><true/>
      <key>strongKill</key><true/>
      <key>description</key><string>TeamViewer</string>
      <key>executable</key><string>TeamViewer.exe</string>
      <key>os</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>currentUser</key><true/>
      <key>strongKill</key><true/>
      <key>description</key><string>AnyDesk</string>
      <key>executable</key><string>AnyDesk.exe</string>
      <key>os</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>currentUser</key><true/>
      <key>strongKill</key><true/>
      <key>description</key><string>OBS Studio</string>
      <key>executable</key><string>obs64.exe</string>
      <key>os</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>currentUser</key><true/>
      <key>strongKill</key><true/>
      <key>description</key><string>Discord (screen share)</string>
      <key>executable</key><string>Discord.exe</string>
      <key>os</key><integer>1</integer>
    </dict>
  </array>

  <!-- ==================== SESSION / LOGGING ==================== -->
  <key>examSessionClearCookiesOnStart</key>
  <true/>
  <key>examSessionClearCookiesOnEnd</key>
  <false/> <!-- keep session so a mid-test reconnect doesn't force re-login -->
  <key>enableLogging</key>
  <true/>
  <key>sebConfigPurpose</key>
  <integer>0</integer>

  <!-- ==================== ADMIN / SETTINGS LOCK ==================== -->
  <key>hashedAdminPassword</key>
  <string></string>

  <key>originatorVersion</key>
  <string>SEB_Win_3.6.0</string>

</dict>
</plist>
