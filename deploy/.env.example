# Compose-level secrets for docker-compose.prod.yml (Postgres + Redis containers).
# Copy to deploy/.env on the droplet and fill in real values — these are
# DIFFERENT from backend/.env (the Node app's own config), though
# backend/.env's DATABASE_URL and REDIS_URL must use the same values you put here.

POSTGRES_USER=talentq
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=test_platform

REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
