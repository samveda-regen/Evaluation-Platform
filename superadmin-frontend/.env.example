# Backend API base URL. Leave unset in dev (proxied) and in production
# (defaults to same-origin "/api" behind the reverse proxy).
# VITE_API_BASE_URL="https://your-superadmin-domain/api"

# Socket.io server URL. Leave unset in dev/production for the same reasons
# as VITE_API_BASE_URL above.
# VITE_SOCKET_URL="https://your-superadmin-domain"

# The exam platform's (main frontend's) public origin, no trailing slash.
# Required in production for the Accounts page's "View as this admin"
# (impersonate) button to open the right app — without it, that button falls
# back to a guessed URL and shows a warning toast when clicked.
VITE_Impersonating_url_superadmin="https://your-exam-platform-domain"
